{
  "manifest_version": 3,
  "name": "SIDEBAR EDITION TOOLS",
  "version": "1.0",
  "description": "Edit any page with full HTML support",

  "permissions": ["storage"],

  "host_permissions": [
    "https://steamcommunity.com/profiles/*",
    "https://steamcommunity.com/id/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://steamcommunity.com/profiles/*",
        "https://steamcommunity.com/id/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}